<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto Reply"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Responde automáticamente los mensajes que te llegan, en cualquier app, usando IA."
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API Key de Gemini (Google AI Studio)"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="AIza..."
        android:inputType="textPassword"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instrucciones para la IA (ej: tono, qué contestar)"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/promptInput"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Ej: Respondé de forma breve y cordial. Si preguntan por turnos, decí que te van a contactar a la brevedad."
        android:gravity="top"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar configuración"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/permissionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Habilitar acceso a notificaciones"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/overlayPermissionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Habilitar burbuja flotante"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/chooseAppsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Elegir apps (opcional)"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/activeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-respuesta activa"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Estado: inactivo"
        android:textSize="14sp"/>

</LinearLayout>
